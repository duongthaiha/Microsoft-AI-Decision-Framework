# Copy this file to `.env` and fill in your values.
# `.env` holds secrets and must NOT be committed.

# --- Auth ---
# "key"   -> use FOUNDRY_API_KEY (default)
# "entra" -> use Microsoft Entra via DefaultAzureCredential (e.g. `az login`).
#            Use this when the Foundry resource has API-key auth disabled.
FOUNDRY_AUTH_MODE=key

# --- Required: Azure AI Foundry (BYOK) ---
# Provider type:
#   azure  -> native Azure endpoint (*.openai.azure.com). Endpoint is host-only;
#             FOUNDRY_API_VERSION applies. (default)
#   openai -> OpenAI-compatible endpoint; endpoint is normalized to end with
#             /openai/v1/ and FOUNDRY_WIRE_API applies.
FOUNDRY_PROVIDER_TYPE=azure

# Your Foundry / Azure OpenAI endpoint.
#   azure  -> https://my-resource.openai.azure.com   (any /openai/... path is stripped)
#   openai -> https://my-resource.services.ai.azure.com  (-> .../openai/v1/)
FOUNDRY_ENDPOINT=https://your-resource.openai.azure.com

# Your Foundry API key. Required only when FOUNDRY_AUTH_MODE=key.
FOUNDRY_API_KEY=your-foundry-api-key

# --- Optional ---
# Deployment / model name as configured in your Foundry resource.
ADVISOR_MODEL=gpt-4o

# Entra token scope (used when FOUNDRY_AUTH_MODE=entra).
FOUNDRY_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default

# Azure API version (used when FOUNDRY_PROVIDER_TYPE=azure).
FOUNDRY_API_VERSION=2024-10-21

# Wire protocol (used when FOUNDRY_PROVIDER_TYPE=openai):
#   "responses"   -> GPT-5 series, reasoning, tool namespacing
#   "completions" -> broad compatibility / older models
FOUNDRY_WIRE_API=responses
