{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "2941731508090604070"
    }
  },
  "parameters": {
    "agentName": {
      "type": "string",
      "defaultValue": "advisor-agent"
    },
    "foundryAuthMode": {
      "type": "string",
      "defaultValue": "entra"
    },
    "foundryApiKey": {
      "type": "string",
      "defaultValue": ""
    },
    "advisorModel": {
      "type": "string",
      "defaultValue": "gpt-4o"
    },
    "advisorOrganizationContext": {
      "type": "string",
      "defaultValue": ""
    }
  },
  "variables": {
    "agentIdentityName": "[format('{0}-id', parameters('agentName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('agentIdentityName')]",
      "location": "[resourceGroup().location]"
    }
  ],
  "outputs": {
    "agentIdentityId": {
      "type": "string",
      "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('agentIdentityName'))]"
    },
    "agentIdentityClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('agentIdentityName')), '2023-01-31').clientId]"
    },
    "agentIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('agentIdentityName')), '2023-01-31').principalId]"
    },
    "deploymentNotes": {
      "type": "string",
      "value": "Foundry project and agent must be created via Portal or Foundry SDK after identity provisioning. Assign the identity Cognitive Services OpenAI User role on Foundry resource if using Entra auth."
    }
  }
}