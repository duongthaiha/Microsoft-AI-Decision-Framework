# ============================================================
# .dockerignore — agents/advisor/ (workspace root)
# Build context is this directory; exclude large/unnecessary paths.
# ============================================================

# npm workspace node_modules — installed fresh inside the image
node_modules/
*/node_modules/
**/node_modules/

# Compiled output — rebuilt inside the image
dist/
*/dist/
**/dist/

# TypeScript incremental build info
*.tsbuildinfo
**/tsconfig.tsbuildinfo

# azd / Azure environment files — never ship
.azure/
*.env
.env*
*.env.*

# Dev/test-only workspaces — not needed in the API image
cli/
eval/

# Local config / editor files
.editorconfig
.vscode/
.idea/

# Git
.git/
.gitignore

# Docs and repo-level assets
docs/
data/docs/
README.md
*.md

# Scripts — infra-only
infra/
