{
  "name": "@advisor/shared",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared TypeScript contracts, types, and validators for the AI Framework Advisor Agent POC",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
