# agent/.env.local.example — copy to .env.local and fill in your values.
# .env.local is git-ignored; this template is safe to commit.
#
# Usage:
#   cd agent && set -a && source .env.local && set +a && node dist/index.js

# ── Azure resource endpoints ───────────────────────────────────────────────
COSMOS_ENDPOINT=https://<cosmos-account>.documents.azure.com:443/
SEARCH_ENDPOINT=https://<search-account>.search.windows.net
AOAI_ENDPOINT=https://<aoai-account>.openai.azure.com/
AOAI_MODEL_DEPLOYMENT=gpt-4.1-mini

# ── Observability ─────────────────────────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://...

# ── Entra JWT validation ───────────────────────────────────────────────────
# Tenant ID — used to derive JWKS URI and expected issuer automatically.
ENTRA_TENANT_ID=<your-tenant-id>
# Full api:// audience URI for the custom scope defined on the app registration.
# Must match exactly the `aud` claim in access tokens (v2 endpoint, custom scopes).
ENTRA_API_AUDIENCE=api://<app-id>

# ── Local dev flags ───────────────────────────────────────────────────────
ADVISOR_LOCAL_DEV=true
# Set to true to skip Entra sign-in (demo mode). Admin routes remain blocked.
ADVISOR_DEMO_MODE=false
NODE_ENV=development
PORT=8080

# ── Subscription context ──────────────────────────────────────────────────
AZURE_TENANT_ID=<your-tenant-id>
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
