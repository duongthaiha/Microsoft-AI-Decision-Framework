{
  "name": "advisor-agent-root",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "agent",
    "web",
    "tests"
  ],
  "scripts": {
    "lint": "npm run lint --workspace=agent --workspace=web",
    "build": "npm run build --workspace=agent --workspace=web",
    "test": "npm run test --workspace=agent && npm run test --workspace=tests",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.4.0"
  }
}
